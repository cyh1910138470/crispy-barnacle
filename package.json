{
  "name": "msc-tt",
  "version": "0.1.0",
  "description": "MSC-TT 桌面音乐播放器",
  "main": "./out/main/index.js",
  "author": "MSC-TT",
  "scripts": {
    "dev": "chcp 65001 >nul && electron-vite dev",
    "build": "electron-vite build",
    "build:server": "node scripts/build-audio-server.mjs",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:win": "npm run build:server && electron-vite build && set ELECTRON_BUILDER_CACHE=.eb-cache&& electron-builder --win --x64",
    "postinstall": "electron-vite build"
  },
  "build": {
    "appId": "com.msctt.desktop",
    "productName": "MSC-TT",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/audio-server",
        "to": "audio-server"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MSC-TT-${version}-安装版.exe"
    },
    "portable": {
      "artifactName": "MSC-TT-${version}-便携版.exe"
    }
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.55.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.1.2",
    "howler": "^2.2.4",
    "music-metadata": "^7.0.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.1"
  }
}
