{
  "appId": "com.msctt.mobile",
  "appName": "MSC-TT",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "higequ.com",
      "*.higequ.com",
      "xmwav.net",
      "*.xmwav.net",
      "gmmp3.com",
      "*.gmmp3.com",
      "*.kuwo.cn",
      "*.kwcdn.cn",
      "corsproxy.io",
      "api.allorigins.win",
      "api.codetabs.com"
    ]
  },
  "android": {
    "buildOptions": {
      "signingType": "apk"
    },
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0e1418",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0e1418"
    }
  }
}
